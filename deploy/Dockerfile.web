# syntax=docker/dockerfile:1
#
# Static build of apps/web served by nginx (unprivileged), with SPA fallback and `/api` reverse-proxied
# to the API so the browser stays same-origin (cookies, CSRF Origin check). The runtime configuration
# (`/config.json`: installation name, auth mode) is generated at container start from the environment;
# the bundle carries no environment value (STACK-5). Build context = repository root.
#
#   docker build -f deploy/Dockerfile.web -t sales-force-web .

ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine

FROM ${NODE_IMAGE} AS build
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm fetch --frozen-lockfile
COPY . .
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store \
    pnpm install --offline --frozen-lockfile --filter "@salesforce/web..."
# Builds the workspace dependencies first (contracts, domain), then the web app (tsc + vite build).
RUN pnpm --filter "@salesforce/web..." run build

FROM ${NGINX_IMAGE} AS runtime
COPY --from=build /repo/apps/web/dist/ /usr/share/nginx/html/
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --chmod=0755 deploy/nginx/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
USER root
# Only config.json is writable by the (unprivileged) runtime user; the rest of the site stays read-only.
RUN touch /usr/share/nginx/html/config.json && chown nginx:nginx /usr/share/nginx/html/config.json
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
