# Settings for deploy/docker-compose.dev.yml. Copy to deploy/.env (git-ignored).
# SEED_DEV_PASSWORD is REQUIRED (the compose file refuses to start without it); every other value has a
# working local default. Nothing in this file is a real secret.

# Host ports (all bound to 127.0.0.1)
# WEB_HOST_PORT=8080
# API_HOST_PORT=3000
# POSTGRES_HOST_PORT=55432

# Throwaway local database credentials (the database is reachable from this machine only)
# POSTGRES_USER=salesforce
# POSTGRES_PASSWORD=salesforce_local_dev
# POSTGRES_DB=salesforce

# REQUIRED. Password of the synthetic demo accounts created by the dev seed. Choose your own: 12+
# characters, not a common password, never reused from anywhere real. There is no default on purpose.
SEED_DEV_PASSWORD=

# Label shown in the web app; per installation, never a customer name in the repository
# INSTALLATION_NAME=Sales Force

# LOG_LEVEL=info

# Sankhya (WORKER ONLY). Default is the synthetic gateway. Live mode needs a non-production Sankhya
# (SNK-3) and values from your own secret store; never commit them.
# SANKHYA_MODE=fake
# SANKHYA_BASE_URL=
# SANKHYA_ALLOWED_HOSTS=
# SANKHYA_ENVIRONMENT=
# SANKHYA_CLIENT_ID=
# SANKHYA_CLIENT_SECRET=
# SANKHYA_X_TOKEN=
