# Secret. ${SF_SECRETS_DIR}/api.env: read ONLY by the API container.
#
# DATABASE_URL is the API's own least-privilege role (force_api, created by db-roles.sql): never the superuser,
# never force_migrator, never the worker's role. Same URL shape and TLS notes as migrate.env.example.
DATABASE_URL=postgres://force_api:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB?sslmode=verify-full

# The API reads no Sankhya setting and holds no Sankhya credential (STACK-2). Keep it that way.
#
# Reserved for the API-to-verifier call (STACK-2 option C). NOT read by the API yet: the client is part of the
# external-login work. Same random value as VERIFIER_SHARED_SECRET in verifier.env (>= 32 characters):
# VERIFIER_URL=http://verifier:3002
# VERIFIER_SHARED_SECRET=
#
# Optional tuning (see apps/server/src/config/api-env.ts), e.g.:
# SESSION_IDLE_TIMEOUT_MINUTES=720
