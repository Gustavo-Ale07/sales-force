# Secret. Only for the `restore-check` ops job: ${SF_SECRETS_DIR}/restore-test.env. A DISPOSABLE database that
# is never the staging database; its contents are overwritten. The script refuses a target with the same host,
# port and database name as DATABASE_URL, and a target whose database name does not contain "restore", "test"
# or "scratch". Percent-encode reserved characters in USER and PASSWORD.
RESTORE_TEST_DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_RESTORE_TEST_DB?sslmode=verify-full
# With sslmode=verify-full against a managed database, add &sslrootcert=<mounted CA file path> and mount that
# file read-only in the restore-check container (see database.env.example).
