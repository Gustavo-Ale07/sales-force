# Secret. Only for the `restore-check` ops job: ${SF_SECRETS_DIR}/restore-test.env. A DISPOSABLE database that
# is never the staging database (the script refuses an equal URL); its contents are overwritten.
RESTORE_TEST_DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_SCRATCH_DB?sslmode=verify-full
