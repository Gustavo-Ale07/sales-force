# Secret, OWNER-ONLY. ${SF_SECRETS_DIR}/db-admin.env: read ONLY by the `db-roles` one-time job (profile
# ops-admin), run by the owner. The database ADMINISTRATOR credential (the superuser/admin of the staging
# PostgreSQL) plus the passwords to SET on the three application roles. No application service ever reads this
# file. Delete or archive it offline after the bootstrap if you prefer; re-running needs it again.
#
# Administrator connection (libpq variables). Self-hosted-db: host `postgres`, user/password/database as in
# postgres.env. Managed PostgreSQL: the provider's admin user, with TLS verified (PGSSLMODE=verify-full and
# PGSSLROOTCERT=<mounted CA file>; mount it into the db-roles service with a compose override).
PGHOST=postgres
PGPORT=5432
PGUSER=REPLACE_ADMIN_USER
PGPASSWORD=REPLACE_ADMIN_PASSWORD
PGDATABASE=REPLACE_DB
# PGSSLMODE=verify-full
# PGSSLROOTCERT=
#
# Passwords for the application roles: three DIFFERENT values, >= 24 characters, only [A-Za-z0-9._~+=:/$-]
# (e.g. `openssl rand -hex 32`), or pre-hashed SCRAM verifiers ("SCRAM-SHA-256$..."). The same values go into
# migrate.env (force_migrator), api.env (force_api) and worker.env (force_worker) DATABASE_URLs.
FORCE_MIGRATOR_PASSWORD=REPLACE_RANDOM_1
FORCE_API_PASSWORD=REPLACE_RANDOM_2
FORCE_WORKER_PASSWORD=REPLACE_RANDOM_3
# Optional, deliberate and once: re-own objects of an already populated database (created earlier by another
# role) to force_migrator. Take a backup first. See the header of db-roles.sql.
# DB_ROLES_ADOPT_EXISTING=on
