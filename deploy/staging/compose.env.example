# Non-secret interpolation values for deploy/docker-compose.staging.yml. Copy OUTSIDE the repository, e.g.
# /etc/salesforce/staging/compose.env, and pass it with: docker compose --env-file <that file> ...
# Placeholders only. Secrets do NOT belong here (they go in the per-role *.env files, see *.env.example).

# Directory OUTSIDE the repository holding the per-role secret files: migrate.env, api.env, worker.env, verifier.env,
# edge.env, backup.env (+ postgres.env, restore-test.env, offsite.env, db-admin.env when used). Permissions:
# owner-only (0600 files, 0700 directory).
SF_SECRETS_DIR=/etc/salesforce/staging/secrets
# Host directory for logical dumps (ops profile), outside the repository.
SF_BACKUP_DIR=/var/backups/salesforce-staging
# uid:gid the ops containers (backup, restore-check, offsite, db-roles) run as: the deploy user that owns
# SF_BACKUP_DIR and the checked-out deploy/ files (`id -u`:`id -g`). They drop ALL capabilities, so they cannot
# read or write files of another user the way root with CAP_DAC_OVERRIDE could. Never 0:0.
SF_OPS_USER=1001:1001

# Images: explicit and pinned. Built ON the VPS (`docker compose build`) from a git tag/commit; the tag carries
# the commit SHA (the same value in both lines). Rollback = put the previous values back (kept images).
# A registry reference (registry/name:sha or @digest) works unchanged if one is adopted later.
SERVER_IMAGE=sales-force-server:REPLACE_WITH_SHA
WEB_IMAGE=sales-force-web:REPLACE_WITH_SHA
CADDY_IMAGE=caddy:REPLACE_WITH_PINNED_TAG
# Off-site backup job (profile offsite): the image built from deploy/staging/Dockerfile.offsite on top of a pinned
# Alpine release (aws-cli + age), or a prebuilt pinned image providing both. Pending infrastructure, see offsite.env.
OFFSITE_BASE_IMAGE=alpine:REPLACE_WITH_PINNED_TAG
OFFSITE_IMAGE=sales-force-offsite:REPLACE_WITH_PINNED_TAG
# Same major as production (DATA-1; final major pending V-15). Used by the self-hosted database and ops jobs.
PG_MAJOR=17

# Public staging host name. PLANNED value shown (production later: force.sistemasplac.com.br). DNS for it is NOT
# created yet (owner item): the A/AAAA record must point at this host, and ports 80/443 must be reachable from the
# internet, before the first start so Caddy can obtain the certificate (ACME HTTP-01). The mobile app reaches this
# host over the public internet: it must not depend on an IP allow-list or a VPN.
STAGING_DOMAIN=force-staging.sistemasplac.com.br
INSTALLATION_NAME=Sales Force Staging

# Authentication modes, explicit: local login for admin and technical only (operational login off). Both must be `local`.
API_AUTH_MODE=local
WEB_AUTH_MODE=local

# Dataset identity of THIS staging installation (slugs; never reuse the production identity).
SF_ERP_ENVIRONMENT=staging
SF_DATASET_ID=staging-REPLACE-1

# Sankhya (worker): fake unless a NON-production Sankhya is configured (SNK-3).
SANKHYA_MODE=fake
ALLOW_FAKE_GATEWAY=1
# Required (true|false) when SANKHYA_MODE=live; leave empty with fake.
SYNC_MIRROR_ENABLED=

# Product photos (worker -> persistent volume `product_media`; INTERIM filesystem store until V-05 closes).
# Disabled by default: nothing is registered or scheduled. Enable only after the first load
# (docs/implementation/product-media.md). Non-secret values; the cron frequency is PROPOSED, not decided.
PRODUCT_MEDIA_SYNC_ENABLED=false
PRODUCT_MEDIA_MAX_BYTES=5242880
# Largest generated thumbnail the API serves (each photo gets a 256 px WebP, at most 256 KiB, from the worker).
PRODUCT_MEDIA_THUMB_MAX_BYTES=262144
PRODUCT_MEDIA_SYNC_CRON=30 3 * * *
PRODUCT_MEDIA_SYNC_CONCURRENCY=2
PRODUCT_MEDIA_VERIFY_OBJECTS=true
PRODUCT_MEDIA_ALLOW_FAKE_GATEWAY=false
PRODUCT_MEDIA_SOURCE_FAILURE_LIMIT=3

# Sankhya user login (AUTH-5): browser -> API -> internal verifier -> Sankhya SANDBOX. OFF by default.
# To turn it on (sandbox only, SNK-3): put the same VERIFIER_SHARED_SECRET in api.env and verifier.env, then set
#   EXTERNAL_LOGIN_ENABLED=1, VERIFIER_MODE=live, VERIFIER_SANKHYA_BASE_URL=https://<account>-teste.sankhyacloud.com.br,
#   VERIFIER_EGRESS_NETWORK=verifier_egress
# The verifier refuses any host that is not a `*-teste.sankhyacloud.com.br` origin. Never a production host.
EXTERNAL_LOGIN_ENABLED=0
# 1 = a verified Sankhya user tied by the ERP itself (TSIUSU.CODVEND) to one active, unclaimed seller gets a seller-only Force
# account on first login (needs EXTERNAL_LOGIN_ENABLED=1 and a recent `directoryUsers` mirror). 0 = only administrator-linked accounts.
EXTERNAL_AUTO_PROVISION=0
# Set to 1 only after the sandbox probe proved the decoded login id equals TSIUSU.CODUSU (required before EXTERNAL_AUTO_PROVISION=1).
EXTERNAL_IDUSU_IS_CODUSU_VALIDATED=0
EXTERNAL_DIRECTORY_MAX_AGE_MINUTES=120
VERIFIER_MODE=disabled
VERIFIER_SANKHYA_BASE_URL=
VERIFIER_EGRESS_NETWORK=verifier_noegress

LOG_LEVEL=info
