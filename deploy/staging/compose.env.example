# Non-secret interpolation values for deploy/docker-compose.staging.yml. Copy OUTSIDE the repository, e.g.
# /etc/salesforce/staging/compose.env, and pass it with: docker compose --env-file <that file> ...
# Placeholders only. Secrets do NOT belong here (they go in the per-role *.env files, see *.env.example).

# Directory OUTSIDE the repository holding database.env, api.env, worker.env, edge.env (+ postgres.env,
# restore-test.env when used). Permissions: owner-only (0600 files, 0700 directory).
SF_SECRETS_DIR=/etc/salesforce/staging/secrets
# Host directory for logical dumps (ops profile), outside the repository.
SF_BACKUP_DIR=/var/backups/salesforce-staging

# Images: explicit and pinned (commit-SHA tag or digest). Rollback = put the previous values back.
SERVER_IMAGE=registry.example.invalid/sales-force-server:REPLACE_WITH_SHA
WEB_IMAGE=registry.example.invalid/sales-force-web:REPLACE_WITH_SHA
CADDY_IMAGE=caddy:REPLACE_WITH_PINNED_TAG
# Same major as production (DATA-1; final major pending V-15). Used by the self-hosted fallback and ops jobs.
PG_MAJOR=17

# Public staging host name (DNS A/AAAA must point at this host before the first start).
STAGING_DOMAIN=staging.example.invalid
INSTALLATION_NAME=Sales Force Staging

# Authentication modes, explicit. NOTE: only `dev` exists in the server today and it is refused in production.
API_AUTH_MODE=REPLACE_WITH_PRODUCTION_AUTH_MODE
WEB_AUTH_MODE=standard

# Dataset identity of THIS staging installation (slugs; never reuse the production identity).
SF_ERP_ENVIRONMENT=staging
SF_DATASET_ID=staging-REPLACE-1

# Sankhya (worker): fake unless a NON-production Sankhya is configured (SNK-3).
SANKHYA_MODE=fake
ALLOW_FAKE_GATEWAY=1
# Required (true|false) when SANKHYA_MODE=live; leave empty with fake.
SYNC_MIRROR_ENABLED=

LOG_LEVEL=info
