# Non-secret interpolation values for deploy/docker-compose.staging.yml. Copy OUTSIDE the repository, e.g.
# /etc/salesforce/staging/compose.env, and pass it with: docker compose --env-file <that file> ...
# Placeholders only. Secrets do NOT belong here (they go in the per-role *.env files, see *.env.example).

# Directory OUTSIDE the repository holding the per-role secret files: migrate.env, api.env, worker.env, verifier.env,
# edge.env (+ postgres.env, restore-test.env, offsite.env, db-admin.env when used). Permissions: owner-only (0600
# files, 0700 directory).
SF_SECRETS_DIR=/etc/salesforce/staging/secrets
# Host directory for logical dumps (ops profile), outside the repository.
SF_BACKUP_DIR=/var/backups/salesforce-staging

# Images: explicit and pinned. Built ON the VPS (`docker compose build`) from a git tag/commit; the tag carries
# the commit SHA (the same value in both lines). Rollback = put the previous values back (kept images).
# A registry reference (registry/name:sha or @digest) works unchanged if one is adopted later.
SERVER_IMAGE=sales-force-server:REPLACE_WITH_SHA
WEB_IMAGE=sales-force-web:REPLACE_WITH_SHA
CADDY_IMAGE=caddy:REPLACE_WITH_PINNED_TAG
# Off-site backup job (profile offsite): the image built from deploy/staging/Dockerfile.offsite on top of a pinned
# Alpine release (aws-cli + age), or a prebuilt pinned image providing both. Pending infrastructure, see offsite.env.
OFFSITE_BASE_IMAGE=alpine:REPLACE_WITH_PINNED_TAG
OFFSITE_IMAGE=sales-force-offsite:REPLACE_WITH_PINNED_TAG
# Same major as production (DATA-1; final major pending V-15). Used by the self-hosted database and ops jobs.
PG_MAJOR=17

# Public staging host name. PLANNED value shown (production later: force.sistemasplac.com.br). DNS for it is NOT
# created yet (owner item): the A/AAAA record must point at this host, and ports 80/443 must be reachable from the
# internet, before the first start so Caddy can obtain the certificate (ACME HTTP-01). The mobile app reaches this
# host over the public internet: it must not depend on an IP allow-list or a VPN.
STAGING_DOMAIN=force-staging.sistemasplac.com.br
INSTALLATION_NAME=Sales Force Staging

# Authentication modes, explicit: admin-only local login (operational login off). Both must be `local`.
API_AUTH_MODE=local
WEB_AUTH_MODE=local

# Dataset identity of THIS staging installation (slugs; never reuse the production identity).
SF_ERP_ENVIRONMENT=staging
SF_DATASET_ID=staging-REPLACE-1

# Sankhya (worker): fake unless a NON-production Sankhya is configured (SNK-3).
SANKHYA_MODE=fake
ALLOW_FAKE_GATEWAY=1
# Required (true|false) when SANKHYA_MODE=live; leave empty with fake.
SYNC_MIRROR_ENABLED=

LOG_LEVEL=info
