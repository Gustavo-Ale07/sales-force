# Secret. ${SF_SECRETS_DIR}/worker.env: read ONLY by the worker container.
#
# DATABASE_URL is the worker's own least-privilege role (force_worker, created by db-roles.sql): never the
# superuser, never force_migrator, never the API's role. Same URL shape and TLS notes as migrate.env.example.
DATABASE_URL=postgres://force_worker:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DB?sslmode=verify-full

# The worker receives none of the verifier secrets and never user passwords (STACK-2 option C).
#
# Sankhya (the ONLY place Sankhya settings may live, STACK-2). Leave empty while SANKHYA_MODE=fake. Live mode:
# a NON-production Sankhya only (SNK-3; the gateway refuses production), and only after the owner authorizes
# it. Never commit real values.
# SANKHYA_BASE_URL=
# SANKHYA_ALLOWED_HOSTS=
# SANKHYA_ENVIRONMENT=sandbox
# SANKHYA_CLIENT_ID=
# SANKHYA_CLIENT_SECRET=
# SANKHYA_X_TOKEN=
