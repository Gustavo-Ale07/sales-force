# Secret. For the default initial staging database (--profile self-hosted-db): ${SF_SECRETS_DIR}/postgres.env.
# These are the SUPERUSER credentials of the database container: used by the postgres container itself and by the
# owner (db-admin.env, `db-roles` job). NO application service uses them: migrate, api and worker connect as
# force_migrator / force_api / force_worker (migrate.env, api.env, worker.env), created by db-roles.sql.
POSTGRES_DB=REPLACE_DB
POSTGRES_USER=REPLACE_USER
POSTGRES_PASSWORD=REPLACE_LONG_RANDOM_PASSWORD
