# Sales Force — local development environment template.
# Copy to `.env` (git-ignored) and adjust. Production/staging values are provided by the
# deployment (see deploy/.env.example), never committed. Contains NO real secrets.
# Both server processes validate their environment at start-up and list every problem at once
# (values are never printed).

NODE_ENV=development
# debug | info | warn | error | fatal | silent. Logs are JSON (pino) with credentials redacted.
LOG_LEVEL=info

# PostgreSQL started by deploy/docker-compose.dev.yml (host port 55432, 127.0.0.1 only)
POSTGRES_MAJOR=17
DATABASE_URL=postgres://salesforce:salesforce_local_dev@127.0.0.1:55432/salesforce
# Connection pool size of each process (1-100).
DB_POOL_MAX=10

# --- API process (apps/server: pnpm dev:api) ---
API_HOST=127.0.0.1
API_PORT=3000
# Authentication: only `dev` exists today. The API refuses to boot with AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE=dev
# Password given to the seeded development accounts (choose your own; min 12 chars). Not used by any real environment.
SEED_DEV_PASSWORD=change-me-local-only

# --- Worker process (apps/server: pnpm dev:worker) ---
# Loopback health endpoint for the container HEALTHCHECK (GET /health).
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3001
# Five-field cron of the scheduled sync.heartbeat job (default: every minute).
HEARTBEAT_CRON=* * * * *
# Time allowed for running jobs to finish on SIGTERM (ms).
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# --- Sankhya (WORKER ONLY: the API never reads these) ---
# `fake` uses synthetic fixtures. `live` needs credentials from your secret store — never commit them.
SANKHYA_MODE=fake
# Optional bootstrap installation configuration (JSON snapshot, no secrets) used by `pnpm db:seed`
# until the Sankhya-side model exists (U-10/U-11). Unset: the synthetic demo configuration.
# SF_CONFIG_FILE=./local/installation-configuration.json

# Setup order on a fresh database: pnpm db:migrate, then pnpm db:queue:install (pg-boss schema and
# queues), then pnpm db:seed (optional, development only). The processes never migrate at start (DATA-2).
