# Sales Force — local development environment template.
# Copy to `.env` (git-ignored) and adjust. Production/staging values are provided by the
# deployment (never committed; the deploy templates arrive with the deploy work package, OPS-3).
# Contains NO real secrets. Both server processes validate their environment at start-up and list
# every problem at once (values are never printed).

# Required: there is no default. A process started without it refuses to run.
# development | test | production
NODE_ENV=development
# debug | info | warn | error | fatal | silent. Logs are JSON (pino) with credentials redacted.
LOG_LEVEL=info

# PostgreSQL started by deploy/docker-compose.dev.yml (host port 55432, 127.0.0.1 only)
POSTGRES_MAJOR=17
DATABASE_URL=postgres://salesforce:salesforce_local_dev@127.0.0.1:55432/salesforce
# Connection pool size of each process (1-100).
DB_POOL_MAX=10

# --- API process (apps/server: pnpm dev:api) ---
API_HOST=127.0.0.1
API_PORT=3000
# Authentication: only `dev` exists today. The API refuses AUTH_MODE=dev when NODE_ENV=production,
# and (in any environment) unless ALLOW_DEV_AUTH=1 is set explicitly.
AUTH_MODE=dev
ALLOW_DEV_AUTH=1
# Session lifetime: idle timeout (minutes, slid by activity) and absolute cap (hours).
SESSION_IDLE_TIMEOUT_MINUTES=720
SESSION_ABSOLUTE_TIMEOUT_HOURS=168
# Origins allowed to send state-changing requests (CSRF Origin check), comma-separated, no path.
# Optional outside production (the Vite dev/preview origins are used); required in production.
# ALLOWED_ORIGINS=https://app.example.com
# Argon2id cost (defaults are the OWASP minimum; production refuses lower values).
# PASSWORD_HASH_MEMORY_KIB=19456
# PASSWORD_HASH_TIME_COST=2
# PASSWORD_HASH_PARALLELISM=1
# Reverse proxies whose X-Forwarded-For is trusted: a hop count (e.g. 1) or a comma list of IPs/CIDRs.
# Unset = trust nobody (the socket address is the client). Never trust everything.
# TRUST_PROXY=1
# HTTP timeouts (ms).
# REQUEST_TIMEOUT_MS=30000
# KEEP_ALIVE_TIMEOUT_MS=65000
# CONNECTION_TIMEOUT_MS=120000

# --- Development seed / account CLI (never used by a real environment) ---
# `pnpm db:seed` refuses without SEED_DEV_PASSWORD (there is no default), refuses NODE_ENV=production
# and refuses a non-loopback database. Choose your own value: 12+ characters, not a common password.
# SEED_DEV_PASSWORD=
# `pnpm --filter @salesforce/server create-user --email ... --name ... --role admin` reads the password
# from ACCOUNT_PASSWORD or, with --password-stdin, from standard input. Never a command-line argument.
# ACCOUNT_PASSWORD=
# ALLOW_REMOTE_DB=1   # only for a deliberate action on a non-loopback database

# --- Worker process (apps/server: pnpm dev:worker) ---
# Loopback health endpoint for the container HEALTHCHECK (GET /health).
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3001
# Five-field cron of the scheduled sync.heartbeat job (default: every minute).
HEARTBEAT_CRON=* * * * *
# Mirror synchronization from Sankhya (sellers, customers, products, price tables). `false` = no
# scheduled jobs (`pnpm --filter @salesforce/server run sync:once` still works). The default crons are
# PROPOSED frequencies until the Sankhya request limits are measured (spike S0.2).
SYNC_MIRROR_ENABLED=true
# Login-directory mirror only (sellers + directoryUsers); see deploy/staging/compose.env.example.
AUTH_DIRECTORY_SYNC_ENABLED=0
SYNC_CRON_SELLERS=*/15 * * * *
SYNC_CRON_CUSTOMERS=*/10 * * * *
SYNC_CRON_PRODUCTS=*/15 * * * *
# One schedule for price tables, price table versions and list prices.
SYNC_CRON_PRICES=*/10 * * * *
# Time allowed for running jobs to finish on SIGTERM (ms).
WORKER_SHUTDOWN_TIMEOUT_MS=30000

# --- Sankhya (WORKER ONLY: the API never reads these) ---
# `fake` uses synthetic fixtures. `live` needs credentials from your secret store — never commit them.
SANKHYA_MODE=fake
# Optional bootstrap installation configuration (JSON snapshot, no secrets) used by `pnpm db:seed`
# until the Sankhya-side model exists (U-10/U-11). Unset: the synthetic demo configuration.
# SF_CONFIG_FILE=./local/installation-configuration.json

# Setup order on a fresh database: pnpm db:migrate, then pnpm db:queue:install (pg-boss schema and
# queues), then pnpm db:seed (optional, development only). The processes never migrate at start (DATA-2).
