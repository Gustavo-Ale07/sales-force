{
  "name": "@salesforce/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Sales Force API contracts: Zod schemas (source of truth), route registry, generated OpenAPI 3.1 and typed client (STACK-4)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./openapi.json": "./openapi/openapi.json"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test scripts",
    "test": "vitest run",
    "openapi": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check"
  },
  "dependencies": {
    "@salesforce/domain": "workspace:*",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@salesforce/config": "workspace:*",
    "@seriousme/openapi-schema-validator": "2.9.1",
    "@types/node": "22.20.3",
    "eslint": "10.10.0",
    "openapi-typescript": "7.13.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
