{
  "expo": {
    "name": "Force",
    "slug": "force",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon-p.png",
    "userInterfaceStyle": "light",
    "scheme": "salesforce",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.plac.salesforce.dev"
    },
    "android": {
      "package": "br.com.plac.salesforce.dev",
      "versionCode": 1
    },
    "extra": {
      "notice": "Identificadores de pacote provisorios de desenvolvimento; o identificador definitivo depende da conta de loja (MOB-3) e nao foi decidido.",
      "eas": {
        "projectId": "1c87d85a-9a13-4e9a-8b95-43dda00748c5"
      }
    },
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/icon-p.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "./plugins/with-dev-cleartext.js",
      "./plugins/with-staging-signing-guard.js"
    ],
    "owner": "plac-industria-e-comercio-de-artigos-para-festas-ltda"
  }
}
