    "test": "jest",
    "bundle:check": "expo export --platform android --output-dir dist --clear"
  },
  "dependencies": {
    "@salesforce/contracts": "workspace:*",
    "@salesforce/domain": "workspace:*",
    "@salesforce/mobile-db": "workspace:*",
    "drizzle-orm": "0.45.2",
    "expo": "57.0.24",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-network": "~57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@react-native/jest-preset": "~0.86.3",
    "@salesforce/config": "workspace:*",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
