{
  "name": "@salesforce/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Sales Force mobile app (Expo development builds, MOB-1). Online-only shell for now; offline storage waits for spike S7 (MOB-2, V-09)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "typecheck": "tsc -p tsconfig.json",
