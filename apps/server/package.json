{
  "name": "@salesforce/server",
  "version": "0.0.0",
  "private": true,
  "description": "Sales Force modular server: API and Worker entry points, run as separate processes (STACK-2, STACK-3)",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "dev:api": "tsx watch --env-file-if-exists=../../.env src/main-api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/main-worker.ts",
    "start:api": "node dist/main-api.js",
    "start:worker": "node dist/main-worker.js",
    "queue:install": "tsx --env-file-if-exists=../../.env src/queue-install.ts",
    "sync:once": "tsx --env-file-if-exists=../../.env src/sync-once.ts",
    "start:sync-once": "node dist/sync-once.js",
    "seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "config:bootstrap": "tsx --env-file-if-exists=../../.env src/config-bootstrap.ts",
    "account": "tsx --env-file-if-exists=../../.env src/account-cli.ts",
    "create-user": "tsx --env-file-if-exists=../../.env src/account-cli.ts create",
    "bootstrap-admin": "tsx --env-file-if-exists=../../.env src/account-cli.ts create --role admin",
    "start:account": "node dist/account-cli.js",
    "start:config-bootstrap": "node dist/config-bootstrap.js"
  },
  "dependencies": {
    "@nestjs/common": "12.0.3",
    "@nestjs/core": "12.0.3",
    "@nestjs/platform-fastify": "12.0.3",
    "@salesforce/contracts": "workspace:*",
    "@salesforce/db": "workspace:*",
    "@salesforce/domain": "workspace:*",
    "@salesforce/sankhya": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.4",
    "hash-wasm": "4.12.0",
    "pg": "^8.23.0",
    "pg-boss": "12.33.2",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@salesforce/config": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "22.20.3",
    "@types/pg": "^8.23.1",
    "eslint": "10.10.0",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
